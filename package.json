{
  "name": "polyglot-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "worker"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:shared": "npm run build --workspace=@polyglot/shared",
    "worker": "npm run worker --workspace=@polyglot/worker"
  }
}
